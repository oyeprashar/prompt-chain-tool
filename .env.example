# Copy to .env.local. These are NOT private server secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# For a later AI execution phase. Never put this in client-side code.
GEMINI_API_KEY=

# Optional Gemini text model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
